aws_account_id = "123456789012"
project_name   = "hello-world"
instance_type  = "t3.small"
k3s_version    = "v1.36.5+k3s1"
github_oidc_subject = "repo:OWNER@OWNER_ID/REPO@REPO_ID:ref:refs/heads/main"

